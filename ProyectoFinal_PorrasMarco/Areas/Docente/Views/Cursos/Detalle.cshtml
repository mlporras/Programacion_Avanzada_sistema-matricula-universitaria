@model DetalleCursoDocenteVm
<p class="miga">Mis cursos / Detalle</p>
<h1>Curso asignado</h1>
<p class="ayuda">Resumen del curso asignado. Desde aquí se consulta la lista de estudiantes.</p>
<div class="tarjeta">
    <dl class="resumen">
        <div><dt>Código</dt><dd>@Model.Codigo</dd></div>
        <div><dt>Nombre</dt><dd>@Model.Nombre</dd></div>
        <div><dt>Carrera</dt><dd>@Model.Carrera</dd></div>
        <div><dt>Periodo</dt><dd>@Model.Periodo</dd></div>
        <div><dt>Estado</dt><dd>@Model.Estado</dd></div>
        <div><dt>Estudiantes activos</dt><dd>@Model.Estudiantes</dd></div>
    </dl>
    <div class="acciones" style="margin-top:16px;">
        <a class="btn btn-primario" href="/docente/cursos/@Model.Id/estudiantes">Estudiantes del curso</a>
        <a class="btn btn-secundario" href="/docente/cursos">Volver a Mis cursos</a>
    </div>
</div>
