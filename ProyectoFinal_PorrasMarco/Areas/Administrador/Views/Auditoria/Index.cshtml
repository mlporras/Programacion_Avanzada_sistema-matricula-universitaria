@model IReadOnlyList<MovimientoFilaVm>
<p class="miga">Panel / Auditoría</p>
<h1>Auditoría de listas</h1>
<p class="ayuda">Movimientos registrados por los docentes al agregar o remover estudiantes. Esta consulta no edita calificaciones.</p>
@if (Model.Count == 0)
{
    <section class="estado-vacio">
        <p class="meta">Estado vacío</p>
        <h2>No hay movimientos</h2>
        <p>Todavía no se ha agregado ni removido un estudiante desde un curso.</p>
    </section>
}
else
{
    <div class="tabla-contenedor">
        <table>
            <thead>
                <tr><th>Fecha</th><th>Acción</th><th>Curso</th><th>Estudiante</th><th>Responsable</th><th>Justificación</th><th>Estado</th></tr>
            </thead>
            <tbody>
                @foreach (var movimiento in Model)
                {
                    <tr>
                        <td>@movimiento.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@movimiento.Accion</td>
                        <td>@movimiento.Curso</td>
                        <td>@movimiento.Estudiante</td>
                        <td>@movimiento.Responsable</td>
                        <td>@movimiento.Justificacion</td>
                        <td>@movimiento.EstadoAnterior → @movimiento.EstadoNuevo</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
