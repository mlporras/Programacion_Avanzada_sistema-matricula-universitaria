@model OfertaAdministradorVm
<p class="miga">Panel / Carreras</p>
<h1>Carreras</h1>
<p class="ayuda">Administre las carreras. Los registros marcados como demostración son datos sintéticos.</p>
<div class="acciones" style="margin-bottom:16px;">
    <a class="btn btn-primario" href="/administrador/carreras/nueva">Nueva carrera</a>
</div>
<div class="tabla-contenedor">
    <table>
        <thead>
            <tr><th>Código</th><th>Carrera</th><th>Estado</th><th>Acción</th></tr>
        </thead>
        <tbody>
            @if (Model.Carreras.Count == 0)
            {
                <tr><td colspan="4">No hay carreras registradas.</td></tr>
            }
            @foreach (var carrera in Model.Carreras)
            {
                <tr>
                    <td>@carrera.Codigo</td>
                    <td>@carrera.Nombre @if (carrera.EsDemostracion) { <span class="insignia insignia-demo">Demostración</span> }</td>
                    <td><span class="insignia @(carrera.Activa ? "insignia-activo" : "insignia-inactivo")">@(carrera.Activa ? "Activa" : "Inactiva")</span></td>
                    <td><a href="/administrador/carreras/@carrera.Id/editar">Editar</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
