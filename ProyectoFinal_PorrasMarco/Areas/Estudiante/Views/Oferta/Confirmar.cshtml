@model DetalleCursoDisponibleVm
<p class="miga">Cursos disponibles / Confirmación</p>
<h1>Confirmar matrícula</h1>
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alerta alerta-error" role="alert">
        <strong>Error · No se matriculó el curso</strong>
        <p>@Model.Error La carga académica anterior se conserva.</p>
    </div>
}
else
{
    <p class="ayuda">Confirme el resumen para crear la matrícula. Esta acción no se ejecuta al abrir la página.</p>
}
<div class="tarjeta">
    <dl class="resumen">
        <div><dt>Código</dt><dd>@Model.Codigo</dd></div>
        <div><dt>Curso</dt><dd>@Model.Nombre</dd></div>
        <div><dt>Periodo</dt><dd>@Model.Periodo</dd></div>
        <div><dt>Docente</dt><dd>@Model.Docente</dd></div>
    </dl>
    <div class="acciones" style="margin-top:16px;">
        @if (string.IsNullOrEmpty(Model.Error))
        {
            <form method="post" action="/estudiante/cursos/@Model.Id/matricular">
                @Html.AntiForgeryToken()
                <button class="btn btn-primario" type="submit">Confirmar matrícula</button>
            </form>
        }
        <a class="btn btn-secundario" href="/estudiante/cursos">Volver a la oferta</a>
        <a class="btn btn-texto" href="/estudiante/mis-cursos">Ver Mis cursos</a>
    </div>
</div>
